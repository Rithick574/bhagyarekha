{
  "name": "@bhagyarekha/web",
  "version": "0.1.0",
  "private": true,
  "description": "BhagyaRekha Next.js web app — public results UI",
  "type": "module",
  "scripts": {
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "build": "pnpm --filter \"@bhagyarekha/web^...\" run build && next build",
    "start": "next start --port ${WEB_PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@bhagyarekha/contracts": "workspace:*",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-malayalam": "5.3.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
