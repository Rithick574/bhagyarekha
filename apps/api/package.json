{
  "name": "@bhagyarekha/api",
  "version": "0.1.0",
  "private": true,
  "description": "BhagyaRekha NestJS API — modular monolith over PostgreSQL",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"@bhagyarekha/api^...\" run build && tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/cli/migrate.js",
    "db:migrate:status": "tsc -p tsconfig.build.json && node dist/cli/migrate.js --status",
    "env:init": "tsc -p tsconfig.build.json && node dist/cli/env-init.js",
    "seed:demo": "tsc -p tsconfig.build.json && node dist/cli/seed-demo.js",
    "admin:create": "tsc -p tsconfig.build.json && node dist/cli/admin-create.js"
  },
  "dependencies": {
    "@bhagyarekha/contracts": "workspace:*",
    "@bhagyarekha/domain": "workspace:*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/throttler": "6.7.0",
    "@nestjs/typeorm": "12.0.1",
    "argon2": "0.45.1",
    "helmet": "8.3.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "supertest": "7.3.0",
    "tsc-watch": "7.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
