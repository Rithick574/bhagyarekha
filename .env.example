# ---- Shared ----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Free-form environment label used in logs (local, staging, production)
APP_ENV=local
# demo | live  — must match the deployment_metadata row in the database.
# The API refuses to start if they disagree. Demo and live NEVER share a database.
DATA_MODE=demo

# ---- API -------------------------------------------------------------------
API_PORT=3001
# Local Docker Compose database (infra/docker-compose.yml) listens on 5434 so it
# does not clash with a Postgres already installed on 5432.
DATABASE_URL=postgres://bhagyarekha:bhagyarekha_local@localhost:5434/bhagyarekha_demo
# Origin allowed to call the API with credentials (the web app origin).
ALLOWED_ORIGIN=http://localhost:3000
# Public origin of the deployed site. No BhagyaRekha domain has been purchased;
# do not assume one.
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops in front of the API (0 locally).
TRUST_PROXY_HOPS=0
# Reserved for later stages (admin import/review). Documented now so the
# variable names are stable.
ALLOW_SELF_REVIEW=false
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_ENTRIES=20000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# ---- Web -------------------------------------------------------------------
WEB_PORT=3000
# Where the Next.js server reaches the API (private network in production).
INTERNAL_API_BASE_URL=http://localhost:3001

# ---- Integration tests (apps/api) -----------------------------------------
# A throwaway database. Integration tests DROP AND RECREATE its public schema.
TEST_DATABASE_URL=postgres://bhagyarekha:bhagyarekha_local@localhost:5434/bhagyarekha_test
